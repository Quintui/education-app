# https://openrouter.ai/keys — leave empty to run in demo mode (simulated responses)
OPENROUTER_API_KEY=
# Optional model overrides (OpenRouter model ids)
# OPENROUTER_SMART_MODEL=anthropic/claude-opus-5.5
# OPENROUTER_FAST_MODEL=anthropic/claude-sonnet-5.5

# https://elevenlabs.io/app/settings/api-keys (music needs a plan with Eleven Music access)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Where the SQLite database (lumen.db) and lesson media live, relative to the project
# root or absolute. Defaults to ./.data
# DATA_DIR=
