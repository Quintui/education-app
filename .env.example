# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional model overrides
# OPENAI_SMART_MODEL=gpt-6.1-sol   # course + lesson planning, scene animation (gpt-6-astra for top quality)
# OPENAI_FAST_MODEL=gpt-6.1-sol    # knowledge check, notes, quiz, playground, Ask (gpt-6-luna is faster)

# https://elevenlabs.io/app/settings/api-keys (music needs a plan with Eleven Music access)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_v4

# Simulated responses with realistic timing, no API calls (for UI work and recordings)
# LUMEN_DEMO=1

# Where the SQLite database (lumen.db) and lesson media live, relative to the project
# root or absolute. Defaults to ./.data
# DATA_DIR=
