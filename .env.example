# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id, used by every agent (medium reasoning effort)
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# https://elevenlabs.io/app/settings/api-keys (music needs a plan with Eleven Music access)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_v4

# Simulated responses with realistic timing, no API calls (for UI work and recordings)
# LUMEN_DEMO=1

# Where the SQLite database (lumen.db) and lesson media live, relative to the project
# root or absolute. Defaults to ./.data
# DATA_DIR=
